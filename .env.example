# Required for auth (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://127.0.0.1:3000

# Database (local default uses SQLite at ./data/studio.db)
# DATABASE_URL=./data/studio.db
# DATABASE_URL=postgresql://user:pass@host/db   # Neon for production

# Vercel Blob (optional — local ./public/generated used when unset)
# BLOB_READ_WRITE_TOKEN=

# Email (optional locally — emails print to terminal)
# Brevo is checked first, then Resend, then dev console fallback.
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...
# EMAIL_FROM=AI Story Studio <you@yourdomain.com>

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Chinese text providers (DeepSeek recommended fallback for scripts)
DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=
# MOONSHOT_API_KEY=
# MINIMAX_API_KEY=
# STEPFUN_API_KEY=
# ERNIE_API_KEY=
# HUNYUAN_API_KEY=

